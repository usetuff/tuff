{
  "name": "@tracker/server",
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "migrate": "tsx src/db/run.ts",
    "seed": "tsx scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "pretest": "tsx scripts/sweep.ts",
    "test": "rm -rf .storage-test && STORAGE_DIR=.storage-test node --import tsx --test 'test/**/*.test.ts'",
    "sweep": "tsx scripts/sweep.ts",
    "dev:account": "tsx scripts/dev.ts",
    "instance:owner": "tsx src/instanceOwner.ts",
    "reseal": "tsx src/reseal.ts",
    "vapid": "tsx scripts/vapid.ts",
    "mcp": "tsx src/mcp/main.ts",
    "load": "tsx scripts/load.ts",
    "bench": "rm -rf .storage-test && STORAGE_DIR=.storage-test node --import tsx --test --test-concurrency=1 'bench/**/*.bench.ts'",
    "worker": "tsx src/worker.ts",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "@hono/node-ws": "^1.3.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tracker/shared-schema": "workspace:*",
    "fractional-indexing": "^3.2.0",
    "hono": "^4.13.17",
    "jose": "^6.1.0",
    "nodemailer": "10.5.0",
    "postgres": "^3.4.7",
    "uuid": "^13.0.0",
    "ws": "^8.21.3",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1"
  }
}
